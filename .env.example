# Copy to `.env` to override defaults.

# Mock mode: serve everything from in-browser dummy data (no backend needed).
# ON by default — leave it for the Vercel deployment / offline demos.
# Set to false to talk to the real Laravel API instead.
VITE_USE_MOCK=true

# Base URL of the real backend API (only used when VITE_USE_MOCK=false).
VITE_API_URL=http://localhost:8000/api
